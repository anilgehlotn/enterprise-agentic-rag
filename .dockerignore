# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.installed.cfg
build/
dist/
wheels/

# Virtual environments (huge — never needed in image)
venv/
.venv/
env/
genv/
enterprise_env/
tenvv/

# Environment & secrets (never bake keys into an image)
.env
.env.*
!.env.example
commands.md

# Git, CI & IDE
.git/
.gitignore
.github/
.vscode/
.idea/

# Observability local state
.logfire/

# Claude Code memory
.claude/

# Data — lives in GCS, not in the container
DATA/

# Eval suite and tests — run locally / in CI only, not in Cloud Run
evals/
tests/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Streamlit UI — runs locally, not served by Cloud Run
ui/

# Notebooks & docs — not needed at runtime
notebooks/
DOCS/
*.md

# Local processed corpus (regenerated by ingestion; not served by the API)
processed_data/

# OS
.DS_Store
Thumbs.db
*.log

# Local conversation memory (SQLite checkpointer) — never bake it into an image
/state/

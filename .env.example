# Groq Reasoning Engine (Llama 3.3)
GROQ_API_KEY = ""
GROQ_FALLBACK_API_KEY = ""

# Portkey LLM Gateway
PORTKEY_API_KEY = ""

# Self-correcting agent (Corrective RAG + Self-RAG): grade retrieved chunks, rewrite the
# query and retry once when nothing is relevant, then verify the answer against sources.
# Costs +2 LLM calls (grader + verifier) per technical question; a retry adds a rewrite
# call, a second retrieval and a second grading call.
# Set to false to use the original linear graph: planner -> retriever -> responder.
ENABLE_SELF_CORRECTION=true

# Retrieval mode (one collection serves both; it stores a "dense" and a "bm25" vector per chunk):
#   hybrid (default)  dense Gemini search + BM25 keyword search, fused with Qdrant's RRF,
#                     then FlashRank rerank. Best for exact terms (kubectl flags, YAML fields).
#   dense             dense-only search, then FlashRank rerank.
# Collections created before hybrid search must be re-ingested:
#   python -m app.ingestion.processor DATA --wipe
RETRIEVAL_MODE=hybrid

# Conversation memory (LangGraph checkpointer), keyed by thread_id:
#   memory    in-process only; lost on restart
#   sqlite    (default) local file at SQLITE_CHECKPOINT_PATH; survives restarts on one machine
#   postgres  DATABASE_URL; use on Cloud Run (container disk is ephemeral and per instance)
# Any other value fails at API startup.
CHECKPOINTER=sqlite
SQLITE_CHECKPOINT_PATH=./state/checkpoints.sqlite
# Only for CHECKPOINTER=postgres. On Cloud Run this comes from Secret Manager, never from a file.
DATABASE_URL=""

# Per-client-IP rate limits ("<count>/<second|minute|hour|day>"). In-memory, per instance.
RATE_LIMIT_QUERY=20/minute     # /query and /query/stream (shared budget)
RATE_LIMIT_UPLOAD=5/minute     # /documents
# Key limits on X-Forwarded-For (rightmost entry) instead of the TCP peer address.
# Only set true behind a proxy you control (Cloud Run): clients can forge this header.
TRUST_PROXY_HEADERS=false

# Qdrant Vector DB Settings 
QDRANT_API_KEY =""
QDRANT_CLUSTER_ENDPOINT = ""
# Collection name (default enterprise_rag). Use a NEW name when the vector schema changes
# (e.g. enterprise_rag_v2 for the hybrid dense + bm25 schema), so an older deployment that
# still runs the old code keeps working on the old collection while you re-ingest.
QDRANT_COLLECTION=enterprise_rag

# === Observability

# Pydantic Logfire Observability
LOGFIRE_TOKEN =  ""

# LANGSMITH 

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=""


BACKEND_URL = ""


JUDGE_GROQ = ""

GEMINI_API_KEY = ""







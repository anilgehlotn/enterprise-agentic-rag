# ==============================================================================
# Enterprise Agentic RAG: environment template
# Copy to .env and fill in the keys:  cp .env.example .env
# .env is git-ignored and docker-ignored. Never commit real values.
# Commented-out lines show the default the code uses when the variable is unset.
# Full reference: DOCS/05_ENVIRONMENT_VARIABLES.md
# ==============================================================================

# ── LLM keys (required for real queries) ─────────────────────────────────────
# Used directly by NeMo Guardrails (llama-3.1-8b-instant), and by the RAGAS judge
# when JUDGE_GROQ is empty. API startup fails if this is empty (a dummy value is
# enough for /health).
GROQ_API_KEY=
# Portkey gateway: every agent LLM call (planner, grader, rewriter, responder,
# verifier). The Groq keys the agent uses are stored in the Portkey dashboard as
# the "rag" (primary) and "brag" (fallback) integrations.
PORTKEY_API_KEY=
# Read into app/config.py but not used by any code path (Portkey holds the
# fallback key). Kept because the Cloud Run deploy workflow mounts it.
GROQ_FALLBACK_API_KEY=

# ── Embeddings + vector database (required for queries and ingestion) ───────
# Gemini dense embeddings (gemini-embedding-2-preview, 3072-dim).
GEMINI_API_KEY=
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
# Collection name. The code default is "enterprise_rag"; use a NEW name whenever
# the vector schema changes. enterprise_rag_v2 is the hybrid dense + bm25 schema
# that Cloud Run is deployed with. Create/fill it with:
#   python -m app.ingestion.processor DATA --wipe
QDRANT_COLLECTION=enterprise_rag_v2
# hybrid: dense + BM25 prefetch fused with Qdrant RRF, then FlashRank (default).
# dense:  dense-only search, then FlashRank. Any other value fails at startup.
RETRIEVAL_MODE=hybrid

# ── Agent ─────────────────────────────────────────────────────────────────────
# true: grade chunks, rewrite + retry once when none are relevant, verify the
# answer (+2 LLM calls per technical question). false/0/no/off: the original
# linear graph planner -> retriever -> responder.
ENABLE_SELF_CORRECTION=true

# ── Conversation memory (LangGraph checkpointer, keyed by thread_id) ────────
#   memory    in-process only; lost on restart
#   sqlite    (default) local file; survives restarts on one machine
#   postgres  DATABASE_URL; use on Cloud Run (container disk is ephemeral and per instance)
# Any other value fails at API startup.
CHECKPOINTER=sqlite
# Default when unset: <project root>/state/checkpoints.sqlite (git-ignored).
# A relative value is resolved from the working directory.
# SQLITE_CHECKPOINT_PATH=
# Only for CHECKPOINTER=postgres, e.g. postgresql://user:pass@host/db?sslmode=require
# On Cloud Run this comes from Secret Manager, never from a file.
DATABASE_URL=

# ── Rate limiting (per client IP, in memory, per instance) ──────────────────
# Format: <count>/<second|minute|hour|day>. Invalid values fail at startup.
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_UPLOAD=5/minute
# true: key limits on the rightmost X-Forwarded-For entry. Only behind a proxy you
# control (Cloud Run sets true): clients can forge this header.
TRUST_PROXY_HEADERS=false

# ── Observability (optional) ──────────────────────────────────────────────────
# Pydantic Logfire. Empty = no export (the API still starts).
LOGFIRE_TOKEN=
# LangSmith. Set LANGSMITH_TRACING=true together with an API key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=rag_scale_test
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Streamlit UI ──────────────────────────────────────────────────────────────
# FastAPI URL the UI calls (no trailing slash). Use the Cloud Run URL for the demo.
BACKEND_URL=http://localhost:8000

# ── Evals (optional) ──────────────────────────────────────────────────────────
# Separate Groq key for the RAGAS judge, so eval runs can't exhaust GROQ_API_KEY.
JUDGE_GROQ=

# ── Optional paths / container settings ──────────────────────────────────────
# Folder the MCP tool list_indexed_documents reads (default <project root>/processed_data).
# PROCESSED_DATA_DIR=
# FlashRank model cache (default /tmp/flashrank; the Docker image uses /opt/models).
# FLASHRANK_CACHE_DIR=
# fastembed BM25 model cache (default: a temp directory; the Docker image uses /opt/models).
# FASTEMBED_CACHE_PATH=
# Port uvicorn listens on inside the Docker image (default 8080; Cloud Run sets it).
# PORT=8080

# Groq Reasoning Engine (Llama 3.3)
GROQ_API_KEY = ""
GROQ_FALLBACK_API_KEY = ""

# Portkey LLM Gateway
PORTKEY_API_KEY = ""

# Self-correcting agent (Corrective RAG + Self-RAG): grade retrieved chunks, rewrite the
# query and retry once when nothing is relevant, then verify the answer against sources.
# Costs +2 LLM calls (grader + verifier) per technical question; a retry adds a rewrite
# call, a second retrieval and a second grading call.
# Set to false to use the original linear graph: planner -> retriever -> responder.
ENABLE_SELF_CORRECTION=true

# Qdrant Vector DB Settings 
QDRANT_API_KEY =""
QDRANT_CLUSTER_ENDPOINT = ""

# === Observability

# Pydantic Logfire Observability
LOGFIRE_TOKEN =  ""

# LANGSMITH 

LANGSMITH_TRACING=true
